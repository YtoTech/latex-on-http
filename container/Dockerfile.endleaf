# Endleaf by Inkmirage render sandbox.
#
# arm64 and amd64. Everything the job needs is installed here. The container
# has no network at runtime, and tlmgr is removed so a job cannot fetch
# packages. The only build-time downloads are Pandoc, the pinned circuitikz zip and the pinned
# Python wheels of the PDF layout checker (hash-checked). Mermaid, D2, Chromium,
# and Node are not installed.
#
# PIDcircuitTikZ has no CTAN package name (checked 2026-09-26). It is vendored
# from jellespijker/PIDcircuitTikZ (MIT). CircuiTikZ is the separate CTAN
# package `circuitikz`. TikZ is CTAN `pgf`. xeCJK is CTAN `xecjk`, shipped by
# Debian bookworm `texlive-lang-cjk` as xeCJK.sty (kpathsea is case-sensitive).
# TeX Gyre Pagella/Heros/Cursor come from Debian `tex-gyre` (OTF files
# texgyrepagella-regular.otf and siblings). sysml-tikz.sty is vendored.
# Its only \RequirePackage is tikz, already installed. The libraries it
# loads (fit, backgrounds, decorations.markings,
# shapes.geometric, shapes.multipart, plus positioning, calc, and arrows.meta)
# ship in pgf via texlive-pictures.
#
# circuitikz is the exception: Debian bookworm texlive-pictures ships 1.6.0
# (2022/12/10), which lacks many newer symbols. The pinned CTAN release is installed
# into TEXMFLOCAL (/usr/local/share/texmf), which kpathsea searches before the
# Debian tree, and the build fails unless \pgfcircversion is that release.

FROM debian:12-slim

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive \
    PATH="/opt/colophon-pdfcheck/bin:/usr/local/bin:${PATH}" \
    PYTHONPATH=/opt/colophon

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        fontconfig \
        fonts-noto-cjk \
        inkscape \
        librsvg2-bin \
        python3 \
        python3-pip \
        python3-venv \
        xz-utils \
    && apt-get install -y \
        texlive-xetex \
        texlive-lang-cjk \
        texlive-lang-chinese \
        texlive-pictures \
        texlive-science \
        texlive-latex-recommended \
        texlive-fonts-recommended \
        tex-gyre \
        fonts-texgyre \
    && rm -rf /var/lib/apt/lists/*

# circuitikz from CTAN, pinned by version and sha256. The zip layout is
# circuitikz/{README.md,tex/*}; the tex/ files go to tex/latex/circuitikz.
# To move to a newer release, change all three ARGs together: the build fails
# on a sha256 or version mismatch. Extraction uses python3 (no unzip needed).
ARG CIRCUITIKZ_VERSION=1.8.7
ARG CIRCUITIKZ_SHA256=768edfc7d4cbe77145790f5e4fee929437364c9e359ab3d8a04a2dad1593fd9c
ARG CIRCUITIKZ_URL=https://mirrors.ctan.org/graphics/pgf/contrib/circuitikz.zip
RUN set -eu; \
    curl -fsSL -o /tmp/circuitikz.zip "${CIRCUITIKZ_URL}"; \
    echo "${CIRCUITIKZ_SHA256}  /tmp/circuitikz.zip" | sha256sum -c -; \
    mkdir /tmp/circuitikz-src; \
    python3 -I -c 'import sys,zipfile; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])' \
        /tmp/circuitikz.zip /tmp/circuitikz-src; \
    dest=/usr/local/share/texmf/tex/latex/circuitikz; \
    mkdir -p "$dest" /usr/local/share/texmf/doc/latex/circuitikz; \
    cp /tmp/circuitikz-src/circuitikz/tex/* "$dest"/; \
    cp /tmp/circuitikz-src/circuitikz/README.md /usr/local/share/texmf/doc/latex/circuitikz/; \
    grep -qF "\\def\\pgfcircversion{${CIRCUITIKZ_VERSION}}" "$dest/circuitikz.sty"; \
    mktexlsr /usr/local/share/texmf; \
    test "$(kpsewhich circuitikz.sty)" = "$dest/circuitikz.sty"; \
    rm -rf /tmp/circuitikz.zip /tmp/circuitikz-src

# Pandoc 3 is required by pandoc-ext/diagram (Figure AST). Bookworm's Pandoc
# is 2.x. Binaries are pinned; TARGETARCH selects arm64 or amd64.
ARG TARGETARCH
ARG PANDOC_VERSION=3.6.4
RUN set -eu; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in amd64|arm64) ;; *) echo "unsupported arch $arch"; exit 1 ;; esac; \
    curl -fsSL -o /tmp/pandoc.tar.gz \
        "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-${arch}.tar.gz"; \
    tar -C /tmp -xzf /tmp/pandoc.tar.gz; \
    install -m 0755 "/tmp/pandoc-${PANDOC_VERSION}/bin/pandoc" /usr/local/bin/pandoc; \
    rm -rf /tmp/pandoc.tar.gz "/tmp/pandoc-${PANDOC_VERSION}"

# PDF layout checker libraries: pinned, hash-checked cp311 wheels in a venv that
# does not see the Debian site-packages (bookworm ships Shapely 1.8, which lacks
# shapely.polygons). The venv is first on PATH, so `python3` is the venv python.
COPY container/pdfcheck-requirements.txt /tmp/pdfcheck-requirements.txt
RUN set -eu; \
    python3 -m venv /opt/colophon-pdfcheck; \
    /opt/colophon-pdfcheck/bin/pip install --no-cache-dir --require-hashes --only-binary :all: \
        -r /tmp/pdfcheck-requirements.txt; \
    rm -f /tmp/pdfcheck-requirements.txt; \
    python3 -c 'import shapely, pdfminer, scipy, pathlib; \
assert shapely.__version__.startswith("2"), shapely.__version__; \
shapely.polygons([[[0,0],[1,0],[1,1],[0,1]]]); \
from importlib.metadata import version; \
assert version("pdfminer.six") >= "20250506"; \
assert tuple(map(int, scipy.__version__.split(".")[:2])) >= (1, 11); \
exec("for m in (shapely, pdfminer, scipy):\n assert str(pathlib.Path(m.__file__)).startswith(\"/opt/colophon-pdfcheck\"), m.__file__")'; \
    apt-get purge -y python3-pip; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/* /root/.cache

COPY container/xelatex-nonescape /usr/local/bin/xelatex-nonescape
COPY container/pdflatex-nonescape /usr/local/bin/pdflatex
COPY container/endleaf-sandbox-render /usr/local/bin/endleaf-sandbox-render
RUN chmod 0755 /usr/local/bin/xelatex-nonescape /usr/local/bin/pdflatex \
        /usr/local/bin/endleaf-sandbox-render \
    && ln -sf /usr/local/bin/xelatex-nonescape /usr/local/bin/xelatex

COPY vendor/pidcircuittikz/ /usr/local/share/texmf/tex/latex/pidcircuittikz/
# tlmgr package names, not scheme-full. Debian texlive-pictures and
# texlive-science already ship these packages; the verify step checks each
# one and fails the build if a file is missing.
#   circuitikz siunitx pgfplots chemfig mhchem tikz-3dplot tikz-feynman
#   tikz-cd forest tikz-timing bytefield pgfgantt tikz-dimline tikzscale pgf
COPY colophon/share/tex/latex/endleaf-floorplan/ /usr/local/share/texmf/tex/latex/endleaf-floorplan/
COPY colophon/share/tex/latex/sysml-tikz/ /usr/local/share/texmf/tex/latex/sysml-tikz/
COPY colophon/share/tex/latex/colophon-v1/ /usr/local/share/texmf/tex/latex/colophon-v1/
COPY tests/colophon/fixtures/ /tmp/endleaf-fixtures/
COPY container/check_fixture_refusals.py /tmp/endleaf-check-refusals.py
COPY container/run_kind_fixtures.py /tmp/run_kind_fixtures.py
COPY vendor/diagram/diagram.lua /usr/local/share/colophon/diagram.lua
COPY colophon/share/ /usr/local/share/colophon/
COPY colophon/ /opt/colophon/colophon/
COPY container/stamp_reference_docx.py /tmp/stamp_reference_docx.py
COPY container/bake_package_set.py /tmp/endleaf-bake-package-set.py

RUN set -eu; \
    apt-get update -qq; \
    apt-get install -y --no-install-recommends poppler-utils; \
    printf 'shell_escape = f\nopenin_any = p\nopenout_any = p\n' > /etc/texmf/texmf.d/00endleaf.cnf; \
    update-texmf; \
    mktexlsr; \
    fc-cache -f; \
    test "$(kpsewhich circuitikz.sty)" = /usr/local/share/texmf/tex/latex/circuitikz/circuitikz.sty; \
    printf '%s\n' '\documentclass{article}' '\usepackage{circuitikz}' \
        '\begin{document}\typeout{CTZVER|\pgfcircversion}\end{document}' > /tmp/ctzver.tex; \
    cd /tmp; \
    xelatex -interaction=nonstopmode -halt-on-error ctzver.tex > ctzver.out; \
    grep -qF "CTZVER|${CIRCUITIKZ_VERSION}" ctzver.out; \
    rm -f ctzver.*; \
    kpsewhich siunitx.sty; \
    kpsewhich pgfplots.sty; \
    kpsewhich chemfig.sty; \
    kpsewhich mhchem.sty; \
    kpsewhich tikz-3dplot.sty; \
    kpsewhich tikz-feynman.sty; \
    kpsewhich tikzlibrarycd.code.tex; \
    kpsewhich forest.sty; \
    kpsewhich tikz-timing.sty; \
    kpsewhich bytefield.sty; \
    kpsewhich pgfgantt.sty; \
    kpsewhich tikz-dimline.sty; \
    kpsewhich tikzscale.sty; \
    kpsewhich tikz.sty; \
    kpsewhich tikzlibraryshapes.code.tex; \
    kpsewhich pgflibraryarrows.meta.code.tex; \
    kpsewhich tikzlibrarypositioning.code.tex; \
    kpsewhich tikzlibrarycalc.code.tex; \
    kpsewhich tikzlibraryautomata.code.tex; \
    kpsewhich tikzlibrarymindmap.code.tex; \
    kpsewhich endleaf-floorplan.sty; \
    kpsewhich sysml-tikz.sty; \
    kpsewhich tikzlibraryfit.code.tex; \
    kpsewhich tikzlibrarybackgrounds.code.tex; \
    kpsewhich tikzlibrarydecorations.markings.code.tex; \
    kpsewhich tikzlibraryshapes.geometric.code.tex; \
    kpsewhich tikzlibraryshapes.multipart.code.tex; \
    kpsewhich colophon-v1-preamble.tex; \
    kpsewhich endleaf-type.tex; \
    kpsewhich endleaf-page.tex; \
    kpsewhich texgyrepagella-regular.otf; \
    kpsewhich texgyreheros-regular.otf; \
    kpsewhich texgyrecursor-regular.otf; \
    kpsewhich xeCJK.sty; \
    kpsewhich fontspec.sty; \
    kpsewhich tikzlibrarycircuits.pid.ISO14617.code.tex; \
    python3 /tmp/endleaf-bake-package-set.py; \
    rm -f /tmp/endleaf-bake-package-set.py; \
    if command -v asy >/dev/null || command -v asymptote >/dev/null \
        || command -v d2 >/dev/null || command -v mmdc >/dev/null \
        || command -v chromium >/dev/null || command -v node >/dev/null \
        || command -v npm >/dev/null; then \
      echo "asymptote, d2, mmdc, chromium, and node must not be installed"; \
      exit 1; \
    fi; \
    fc-list : family | grep -F "Noto Sans CJK TC"; \
    sed 's/__BODY__/Body 繁體中文 {\\sffamily UI} {\\ttfamily token}/' \
        /usr/local/share/colophon/templates/Weft/wrapper.tex > /tmp/cjk.tex; \
    cd /tmp; \
    xelatex -interaction=nonstopmode -halt-on-error cjk.tex; \
    test -s /tmp/cjk.pdf; \
    pdffonts /tmp/cjk.pdf | tee /tmp/cjk-fonts.txt; \
    grep -qi pagella /tmp/cjk-fonts.txt; \
    grep -qi heros /tmp/cjk-fonts.txt; \
    grep -qi cursor /tmp/cjk-fonts.txt; \
    grep -F "Noto" /tmp/cjk-fonts.txt; \
    if grep -Eiq 'CMR|LMRoman|LatinModernRoman' /tmp/cjk-fonts.txt; then \
      echo "cjk.pdf still uses Computer Modern or Latin Modern Roman"; \
      cat /tmp/cjk-fonts.txt; \
      exit 1; \
    fi; \
    rm -f /tmp/cjk.tex /tmp/cjk.pdf /tmp/cjk.aux /tmp/cjk.log /tmp/cjk.out \
      /tmp/cjk-fonts.txt; \
    cd /tmp/endleaf-fixtures; \
    xelatex -interaction=nonstopmode -halt-on-error packages-once.tex; \
    test -s packages-once.pdf; \
    xelatex -interaction=nonstopmode -halt-on-error floorplan-two-room.tex; \
    test -s floorplan-two-room.pdf; \
    pdftotext -raw floorplan-two-room.pdf - | tee /tmp/floorplan.txt; \
    grep -F "2.00 m" /tmp/floorplan.txt; \
    grep -F "1.50 m" /tmp/floorplan.txt; \
    grep -F "3 m2" /tmp/floorplan.txt; \
    grep -F "2.25 m2" /tmp/floorplan.txt; \
    cd /tmp; \
    python3 /tmp/endleaf-check-refusals.py; \
    python3 /tmp/run_kind_fixtures.py --root /tmp/endleaf-fixtures/kinds; \
    rm -rf /tmp/endleaf-fixtures /tmp/packages-once.* /tmp/floorplan-two-room.* \
      /tmp/endleaf-tikzscale-once.tikz /tmp/endleaf-tikzscale-kind.tikz \
      /tmp/endleaf-check-refusals.py /tmp/run_kind_fixtures.py /tmp/floorplan.txt \
      /tmp/job.* /tmp/body.tex /tmp/input.* /tmp/out.*; \
    command -v pandoc; \
    command -v xelatex; \
    command -v inkscape; \
    python3 -c 'import colophon.sandbox_render'; \
    for lane in InstruMeasure Weft Investor; do \
        pandoc -o /tmp/reference.docx --print-default-data-file reference.docx; \
        python3 /tmp/stamp_reference_docx.py /tmp/reference.docx \
            "/usr/local/share/colophon/templates/${lane}/reference.docx" "$lane"; \
    done; \
    rm -f /tmp/reference.docx /tmp/stamp_reference_docx.py; \
    rm -f /usr/bin/tlmgr; \
    apt-get purge -y curl poppler-utils; \
    apt-get purge -y wget || true; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 endleaf \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin endleaf \
    && chown -R root:root /usr/local/share/colophon /opt/colophon

# Baked at image build. GET /version on the worker reads ENDLEAF_GIT_COMMIT
# or colophon/GIT_COMMIT. Pass --build-arg ENDLEAF_GIT_COMMIT=$(git rev-parse HEAD).
# COLOPHON_GIT_COMMIT is still accepted. When only that arg is set, the build
# logs a deprecation line and the baked commit is that value.
ARG COLOPHON_GIT_COMMIT=unknown
ARG ENDLEAF_GIT_COMMIT=$COLOPHON_GIT_COMMIT
ENV ENDLEAF_GIT_COMMIT=${ENDLEAF_GIT_COMMIT}
LABEL org.opencontainers.image.source="https://github.com/chouswei/latex-on-http" \
      org.opencontainers.image.revision="${ENDLEAF_GIT_COMMIT}" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
RUN if [ "${COLOPHON_GIT_COMMIT}" != "unknown" ] \
        && [ "${ENDLEAF_GIT_COMMIT}" = "${COLOPHON_GIT_COMMIT}" ]; then \
      echo "deprecated build-arg COLOPHON_GIT_COMMIT; set ENDLEAF_GIT_COMMIT" >&2; \
    fi; \
    printf '%s\n' "${ENDLEAF_GIT_COMMIT}" > /opt/colophon/colophon/GIT_COMMIT \
    && chmod 0444 /opt/colophon/colophon/GIT_COMMIT

USER 10001:10001
WORKDIR /tmp
ENTRYPOINT ["endleaf-sandbox-render"]
