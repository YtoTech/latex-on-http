<h2 id="api-summary">API summary</h2>

<div class="table-wrapper">
  <table class="param-table">
    <thead>
      <tr>
        <th>Endpoint</th>
        <th>Methods</th>
        <th>Purpose</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><a href="{{ rootPrefix }}api/builds-sync/index.html"><code>/builds/sync</code></a></td>
        <td>
          <span class="http-method http-method-get">GET</span>
          <span class="http-method http-method-post">POST</span>
        </td>
        <td class="param-description">Compile a LaTeX document (querystring, JSON or multipart input) and get back the PDF.</td>
      </tr>
      <tr>
        <td><a href="{{ rootPrefix }}api/environment/index.html"><code>/texlive/information</code></a></td>
        <td><span class="http-method http-method-get">GET</span></td>
        <td class="param-description">TeXLive installation information (version, modules, tlmgr revision).</td>
      </tr>
      <tr>
        <td><a href="{{ rootPrefix }}api/environment/index.html#fonts"><code>/fonts</code></a></td>
        <td><span class="http-method http-method-get">GET</span></td>
        <td class="param-description">List fonts usable in compilations.</td>
      </tr>
      <tr>
        <td><a href="{{ rootPrefix }}api/environment/index.html#packages"><code>/packages</code>, <code>/packages/&lt;name&gt;</code></a></td>
        <td><span class="http-method http-method-get">GET</span></td>
        <td class="param-description">List installed LaTeX packages, or get one package's details.</td>
      </tr>
      <tr>
        <td><a href="{{ rootPrefix }}api/caches/index.html"><code>/caches/resources</code></a></td>
        <td>
          <span class="http-method http-method-get">GET</span>
          <span class="http-method http-method-delete">DELETE</span>
        </td>
        <td class="param-description">Inspect or reset the resources cache.</td>
      </tr>
      <tr>
        <td><a href="{{ rootPrefix }}api/caches/index.html#check-cached"><code>/caches/resources/check_cached</code></a></td>
        <td><span class="http-method http-method-post">POST</span></td>
        <td class="param-description">Check whether resources (by content hash) are already cached server-side.</td>
      </tr>
    </tbody>
  </table>
</div>

