<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} · {% endif %}LaTeX-on-HTTP documentation</title>
    <meta name="description" content="Compiles LaTeX documents through an HTTP API: endpoint reference, usage guides and a live playground.">
    <link rel="icon" href="{{ rootPrefix }}assets/favicon.svg">
    <link rel="stylesheet" href="{{ rootPrefix }}assets/css/styles.css">
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="layout">
      <header class="sidebar" id="sidebar">
        <div class="brand">
          <a class="brand-link" href="{{ rootPrefix }}index.html">
            <span class="brand-name">LaTeX<span class="brand-accent">-On-HTTP</span></span>
            <span class="brand-sub">documentation</span>
          </a>
        </div>
        <nav class="nav" aria-label="Documentation">
          {% for group in nav %}
          <div class="nav-group">
            <div class="nav-group-title">{{ group.title }}</div>
            <ul class="nav-list">
              {% for item in group.items %}
              <li>
                <a class="nav-item{% if active == item.url %} is-active{% endif %}" href="{{ rootPrefix }}{{ item.href }}">{{ item.title }}</a>
              </li>
              {% endfor %}
            </ul>
          </div>
          {% endfor %}
        </nav>
        <div class="sidebar-footer">
          <a class="sidebar-link" href="https://github.com/YtoTech/latex-on-http">GitHub ↗</a>
          <a class="sidebar-link" href="https://github.com/YtoTech/latex-on-http/blob/master/CHANGELOG.md">Changelog ↗</a>
        </div>
      </header>

      <div class="main-column">
        <div class="topbar">
          <button class="topbar-button" id="nav-toggle" aria-expanded="false" aria-controls="sidebar" aria-label="Toggle navigation">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <span>Menu</span>
          </button>
          <button class="topbar-button" id="theme-toggle" aria-label="Toggle dark mode">
            <span class="theme-icon-light" aria-hidden="true">☾</span>
            <span class="theme-icon-dark" aria-hidden="true">☀</span>
          </button>
        </div>
        <main class="content" id="main">
          {{ content | safe }}
        </main>
        <footer class="content-footer">
          <p>
            Built from the <a href="https://github.com/YtoTech/latex-on-http/tree/master/docs/site">documentation sources</a> —
            LaTeX-on-HTTP is <a href="https://github.com/YtoTech/latex-on-http">open-source</a> (AGPL).
          </p>
        </footer>
      </div>
    </div>
    <script src="{{ rootPrefix }}assets/js/site.js"></script>
  </body>
</html>
