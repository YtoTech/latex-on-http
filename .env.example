# Copy this file to .env for local Docker Compose configuration.
# .env is ignored by Git and is loaded by Docker Compose and the Makefile.

# Default Compose configuration.
COMPOSE_FILE=docker-compose.yml

# On Linux, select the rootless sandbox override by replacing the line above
# with the following. The Makefile appends it to integration tests as well.
# COMPOSE_FILE=docker-compose.yml:docker-compose.rootless.yml

# Optional operational reporting for handled sandbox infrastructure failures.
# SENTRY_DSN=https://public-key@your-sentry-host/project-id

# Maximum incoming request body size, in bytes. Larger requests are rejected
# with 413 REQUEST_TOO_LARGE before the payload is read. Defaults to 40 MiB.
# MAX_REQUEST_BODY_BYTES=41943040

# Fair-use quota (see docs/rate-limiting-and-quotas.md).
# The quota is active only when VALKEY_HOST is configured; without it the
# API behaves as before. When the store is unreachable requests are allowed
# (fail-open) unless QUOTA_FAIL_MODE=closed.
# VALKEY_HOST=valkey
# VALKEY_PORT=6379
# VALKEY_DB=0
# QUOTA_ENABLED=1
# QUOTA_FAIL_MODE=open
# Client IP source header (use CF-Connecting-IP behind Cloudflare).
# QUOTA_CLIENT_IP_HEADER=X-Forwarded-For
# Optional comma-separated allowlist bypassing the quota.
# QUOTA_TRUSTED_IPS=
# Window limits (requests per client IP).
# QUOTA_LIMIT_SECOND=2
# QUOTA_LIMIT_MINUTE=6
# QUOTA_LIMIT_HOUR=40
# QUOTA_LIMIT_DAY=150
# QUOTA_LIMIT_WEEK=400
# Escalation bans for clients ignoring the 429 responses.
# QUOTA_BAN_SHORT_VIOLATIONS=3
# QUOTA_BAN_SHORT_DURATION=3600
# QUOTA_BAN_LONG_VIOLATIONS=10
# QUOTA_BAN_COUNT_FOR_LONG=3
# QUOTA_BAN_LONG_DURATION=86400
# QUOTA_VIOLATION_SHORT_WINDOW=900
# QUOTA_VIOLATION_LONG_WINDOW=86400

# API usage scoring (see docs/usage-scoring.md).
# 1 token = 1 KiB of data or 1 second of server occupancy; the weights
# rescale each category before summing. Raw measures stay persisted,
# so weights can be recalibrated later without rewriting history.
# USAGE_WEIGHT_INCOMING=1.0
# USAGE_WEIGHT_FETCH=1.0
# Cache-hit bytes discount (0: only network-fetched bytes are charged).
# USAGE_WEIGHT_CACHE=0.0
# USAGE_WEIGHT_PROCESSING=1.0
# USAGE_WEIGHT_OUTGOING=1.0
